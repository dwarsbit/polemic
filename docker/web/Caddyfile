{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	# Vite puts a content hash in these file names.
	handle /projects/assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Every other path under /projects is the app (/projects/<id> opens a project).
	@app path /projects /projects/*
	handle @app {
		header Cache-Control "no-cache"
		try_files {path} /projects/index.html
		file_server
	}

	# Nothing else is served here: /api and the rest belong to the server's
	# own proxy, and a request that reaches this container by mistake gets
	# a 404 rather than the app's page.
	handle {
		respond 404
	}
}
