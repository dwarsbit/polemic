{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	# Vite puts a content hash in these file names.
	@hashed path /projects/assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Every other path under /projects is the app (/projects/<id> opens a project).
	@app {
		path /projects /projects/*
		not path /projects/assets/*
	}
	header @app Cache-Control "no-cache"
	try_files {path} /projects/index.html

	file_server
}
