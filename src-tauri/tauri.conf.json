{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Polemic",
  "version": "0.1.0",
  "identifier": "com.dwarsbit.polemic",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Polemic",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Local-first LaTeX editor",
    "longDescription": "Polemic is an open source, local-first LaTeX editor. Write LaTeX with a code editor and live PDF preview, compiled on your own machine with your own TeX distribution.",
    "copyright": "Copyright (c) 2026 Leon"
  }
}
